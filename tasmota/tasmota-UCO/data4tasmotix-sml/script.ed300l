>D 120
; die Netzwerkadresse der DTU muss in der folgenden Zeile eingetragen werden!
; wenn keine DTU vorhanden Wert leer lassen!
oDTU=""
cpwr=0
cyd=0
cyt=0
fr=0
res=0
cnt=0
str=""
M:msmP=0 60
smP=0
smI=0
smO=0
t:tim2=42

>B
=>SerialConfig 8N1
=>Power ON
=>sensor53 r
; set sensor file download link
;fl1("smlog.txt")
; delete file in case we want to start fresh
;fd("smlog.txt")
; list all files in root directory
fr=fo("/" 0)
for cnt 1 20 1
res=fr(str fr)
if res>0
then
print %cnt% : %str%
else
break
endif
next
fc(fr)

>R
=>Hostname tasmotix-sml
=>FriendlyName1 EMH_ED300L_SML

>M 1
+1,3,s,0,9600,Haus,1
1,77070100010800FF@1000,Energie Import,kWh,E_In,2
1,77070100020800FF@1000,Energie Export,kWh,E_Out,2
1,77070100100700FF@1,Leistung ges.,W,P_Cur,0
#

>b
tim2=42

>T
smP=Haus#P_Cur
smI=Haus#E_In
smO=Haus#E_Out

>E
;print Event occurred
cpwr=gwr( "\"v\":" 2)
cyd=gwr( "\"v\":" 3)
cyt=gwr( "\"v\":" 4)

>S
msmP=smP
; write average to sensor log every minute
if upsecs%600==0
then
; open file for write (note that in the guide, the file open command has a 1 instead of 2. 
; I want to append sensor values instead of overwriting each time)
fr=fo("smlog.txt" 2)
; compose string for tab delimited file entry
if oDTU==""
then
str=tstamp+"\t"+s(msmP)+"\t"+s(smI)+"\t"+s(smO)+"\n"
else
->WebSend [%oDTU%] /api/livedata/status
str=tstamp+"\t"+s(msmP)+"\t"+s(smI)+"\t"+s(smO)+"\t"+s(cpwr)+"\t"+s(cyd)+"\t"+s(cyt)+"\n"
endif
; write string to log file
res=fw(str fr)
; close file
fc(fr)
endif

if tim2<=0
then
->Power OFF
tim2=-1
else
->Power ON
if upsecs%5==0
then
dt [zs2]%0smP%[l2c14s1]Watt[l4c1s1]%1smI% kWh Imp[l5c1s1]%1smO% kWh Exp
endif
endif
